<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MyAmazingWeatherApp.MainPage"
    x:Name="PageRoot">

    <ScrollView Orientation="Vertical" VerticalScrollBarVisibility="Default">
        <ScrollView.Background>
            <Binding Path="BackgroundBrush"/>
        </ScrollView.Background>

        <VerticalStackLayout Padding="0,0,0,30" Margin="40,40,40,0" Spacing="10">
            <Label
                Text="{Binding CityName}"
                FontFamily="InterVariable"
                FontSize="Title"
                TextColor="White"
                HorizontalOptions="Start" />

            <Grid RowDefinitions="*" ColumnDefinitions="*,*">
                <Label
                  Text="{Binding CurrentTemperature}"
                  FontFamily="InterVariable"
                  FontSize="72"
                  FontAttributes="Bold"
                  TextColor="White"
                  HorizontalOptions="Start"
                  Grid.Column="0" />
                <Image
                  Source="{Binding CurrentCondition, Converter={StaticResource ConditionToIconConverter}}"
                  MaximumWidthRequest="90"
                  VerticalOptions="End"
                  HorizontalOptions="End"
                  Grid.Column="1" />
            </Grid>

            <Label
                Text="{Binding CurrentCondition}"
                FontFamily="InterVariable"
                FontSize="Small"
                TextColor="White"
                Margin="0,0,0,10"
                HorizontalOptions="Start" />

            <Label
                Text="⚠️ Data may be out of date (offline mode)"
                IsVisible="{Binding IsDataStale}"
                TextColor="OrangeRed"
                FontAttributes="Italic" />

            <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" Background="#40404040" Padding="10">
                <CollectionView
                  ItemsSource="{Binding HourlyForecasts}"
                  HorizontalScrollBarVisibility="Never"
                  ItemSizingStrategy="MeasureFirstItem">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <StackLayout VerticalOptions="Center" Margin="5">
                                        <Label
                                          Text="{Binding Temperature}"
                                          FontFamily="InterVariable"
                                          TextColor="White"
                                          HorizontalOptions="Center"
                                          Margin="0,0,0,5" />
                                        <Image
                                          Source="{Binding Icon}"
                                          MaximumHeightRequest="30"
                                          MaximumWidthRequest="30" />
                                        <Label
                                          Text="{Binding Time}"
                                          FontFamily="InterVariable"
                                          TextColor="White"
                                          HorizontalOptions="Center"
                                          Margin="0,5,0,0" />
                                    </StackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
            </Border>

            <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" Background="#40404040" Padding="15">
                <CollectionView ItemsSource="{Binding DailyForecasts}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="8">
                                <Image
                                  Source="{Binding Icon}"
                                  MaximumHeightRequest="20"
                                  VerticalOptions="Center"
                                  Grid.Column="0" />
                                <Label
                                  Text="{Binding Day}"
                                  FontFamily="InterVariable"
                                  TextColor="White"
                                  FontSize="18"
                                  VerticalOptions="Center"
                                  Grid.Column="1" />
                                <Label
                                  Text="{Binding MinTemperature}"
                                  FontFamily="InterVariable"
                                  TextColor="#F0F0F0"
                                  FontSize="18"
                                  HorizontalOptions="End"
                                  VerticalOptions="Center"
                                  Grid.Column="2" />
                                <Label
                                  Text="{Binding MaxTemperature}"
                                  FontFamily="InterVariable"
                                  TextColor="White"
                                  FontSize="18"
                                  HorizontalOptions="End"
                                  VerticalOptions="Center"
                                  Grid.Column="3" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*" ColumnSpacing="10" RowSpacing="10">

                <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" Background="#40404040" Grid.Column="0" Grid.Row="0">
                    <VerticalStackLayout Spacing="5" Padding="10" WidthRequest="160" HeightRequest="160" HorizontalOptions="Start">
                        <Label Text="UV Index" FontFamily="InterVariable" FontSize="16" TextColor="White" />
                        <Label Text="{Binding UvIndex}" FontFamily="InterVariable" FontSize="Header" FontAttributes="Bold" TextColor="White" />
                        <Image Source="glasses.png" MaximumHeightRequest="20" HorizontalOptions="Start"/>
                        <Label Text="Exposure to sun" FontFamily="InterVariable" FontSize="14" TextColor="#F0F0F0" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" Background="#40404040" Grid.Column="1" Grid.Row="0">
                    <VerticalStackLayout Spacing="5" Padding="10"  HeightRequest="160" HorizontalOptions="Start">
                        <Label Text="Feels Like" FontFamily="InterVariable" FontSize="16" TextColor="White" />
                        <Label Text="{Binding FeelsLike}" FontFamily="InterVariable" FontSize="Header" FontAttributes="Bold" TextColor="White" />
                        <Image Source="temp.png" MaximumHeightRequest="20" HorizontalOptions="Start"/>
                        <Label Text="Actual temperature" FontFamily="InterVariable" FontSize="14" TextColor="#F0F0F0" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" Background="#40404040" Grid.Column="0" Grid.Row="1">
                    <VerticalStackLayout Spacing="5" Padding="10" WidthRequest="160" HeightRequest="160" HorizontalOptions="Start">
                        <Label Text="Humidity" FontFamily="InterVariable" FontSize="16" TextColor="White" />
                        <Label Text="{Binding Humidity}" FontFamily="InterVariable" FontSize="Header" FontAttributes="Bold" TextColor="White" />
                        <Image Source="drop.png" MaximumHeightRequest="20" HorizontalOptions="Start"/>
                        <Label Text="Water in air" FontFamily="InterVariable" FontSize="14" TextColor="#F0F0F0" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" Background="#40404040" Grid.Column="1" Grid.Row="1">
                    <VerticalStackLayout Spacing="5" Padding="10" WidthRequest="160" HeightRequest="160" HorizontalOptions="Start">
                        <Label Text="Precipitations" FontFamily="InterVariable" FontSize="16" TextColor="White" />
                        <Label Text="{Binding PrecipitationProbability}" FontFamily="InterVariable" FontSize="Header" FontAttributes="Bold" TextColor="White" />
                        <Image Source="umbrella.png" MaximumHeightRequest="20" HorizontalOptions="Start"/>
                        <Label Text="Chance of rain" FontFamily="InterVariable" FontSize="14" TextColor="#F0F0F0" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" Background="#40404040" Grid.Column="0" Grid.Row="2">
                    <VerticalStackLayout Spacing="5" Padding="10" WidthRequest="160" HeightRequest="160" HorizontalOptions="Start">
                        <Label Text="Wind Speed" FontFamily="InterVariable" FontSize="16" TextColor="White" />
                        <Label Text="{Binding WindSpeed}" FontFamily="InterVariable" FontSize="34" FontAttributes="Bold" TextColor="White" />
                        <Image Source="wind.png" MaximumHeightRequest="20" HorizontalOptions="Start"/>
                        <Label Text="Wind strength" FontFamily="InterVariable" FontSize="14" TextColor="#F0F0F0" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" Background="#40404040" Grid.Column="1" Grid.Row="2">
                    <VerticalStackLayout Spacing="5" Padding="10" WidthRequest="160" HeightRequest="160" HorizontalOptions="Start">
                        <Label Text="Pressure" FontFamily="InterVariable" FontSize="16" TextColor="White" />
                        <Label Text="{Binding Pressure}" FontFamily="InterVariable" FontSize="32" FontAttributes="Bold" TextColor="White" />
                        <Image Source="leaves.png" MaximumHeightRequest="20" HorizontalOptions="Start"/>
                        <Label Text="In atmosphere" FontFamily="InterVariable" FontSize="14" TextColor="#F0F0F0" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
